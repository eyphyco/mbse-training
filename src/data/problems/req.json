  {
    "id": "req-concept-3",
    "type": "choose_construct",
    "items": [
      "mu-req-concept"
    ],
    "level": 3,
    "title": "要求に書かないこと",
    "prompt_md": "要求 `MaxSpeed`（text: 最高速度 180 km/h を出せること）に、「エンジン出力を 150 kW にする」という実現方法も書き込みたい。正しい扱いはどれか。",
    "hints_md": [
      "要求は振る舞いや実現方法を持つか。"
    ],
    "explanation_md": "要求は**何を満たすか**を言い、**どう満たすか**は言わない。実現方法は設計要素の仕事で、要求とは **«satisfy»** で結ぶ。\n\n- b: 要求の text に実現方法を混ぜると、別の方法で満たしたとき要求ごと書き換えることになる\n- c: 要求は操作（振る舞い）を持たない\n- d: 要求が包含できるのは要求だけ",
    "choices": [
      {
        "id": "a",
        "text_md": "要求には何を満たすかだけを書き、出力 150 kW は設計要素（Engine の値属性など）に持たせて «satisfy» で要求と結ぶ"
      },
      {
        "id": "b",
        "text_md": "MaxSpeed の text に「エンジン出力 150 kW で」と書き足す"
      },
      {
        "id": "c",
        "text_md": "MaxSpeed に operations 区画を作り、出力を決める操作を書く"
      },
      {
        "id": "d",
        "text_md": "Engine を MaxSpeed の中に包含（⊕）する"
      }
    ],
    "answer": [
      "a"
    ]
